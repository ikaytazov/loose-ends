# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
# Iliyan sends the values by direct message. The same names go into Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Back-end only (front-end can leave empty): full write access, keep secret
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key from console.anthropic.com (back-end only)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Email (back-end only)
TEAM_EMAIL=signalridgeco@gmail.com
GMAIL_BRIDGE_URL=
BRIDGE_SECRET=
TEAM_TIMEZONE=America/Los_Angeles

# 8 am morning-email job (vercel.json). Any long random string; Vercel sends it to the route automatically.
CRON_SECRET=

# Optional: the app's public address, used for the Decisions link in approver emails (issue #16).
# On Vercel it falls back to the production address automatically. Example: https://loose-ends.vercel.app
# APP_URL=
